{
  "cli": {
    "version": "23.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_RINGPORT_API_URL": "https://ai.ringport.app",
        "EXPO_PUBLIC_ONESIGNAL_MODE": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_RINGPORT_API_URL": "https://ai.ringport.app",
        "EXPO_PUBLIC_ONESIGNAL_MODE": "production"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_RINGPORT_API_URL": "https://ai.ringport.app",
        "EXPO_PUBLIC_ONESIGNAL_MODE": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
